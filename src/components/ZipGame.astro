---
interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const en = lang === "en";
---
<section id="playground" class="section container zip-section" aria-label={en ? "Interactive logic game" : "Juego de lógica interactivo"}>
  <div class="section-intro zip-intro">
    <div><p class="kicker">06 / PLAYGROUND</p><h2>{en ? "Take a little break." : "Tómate un pequeño descanso."}</h2></div>
    <p>{en ? "Three logic challenges with walls and winding paths. Connect the numbers in order and fill every square." : "Tres retos de lógica con muros y caminos sinuosos. Conecta los números en orden y recorre todas las casillas."}</p>
  </div>
  <div class="zip-panel" data-zip-game data-lang={lang}>
    <div class="zip-copy">
      <span class="zip-eyebrow">{en ? "INTERACTIVE CHALLENGE" : "RETO INTERACTIVO"} <span aria-hidden="true">✦</span></span>
      <h3>Connect the dots<span class="zip-period">.</span></h3>
      <p>{en ? "No sign-up. No distractions. Just a quick brain workout." : "Sin registro ni distracciones. Solo un pequeño ejercicio mental."}</p>
      <div class="zip-info"><span class="zip-level-label">{en ? "LEVEL" : "NIVEL"} <strong data-zip-level>01 / 03</strong></span><span class="zip-moves-label">{en ? "MOVES" : "MOVIMIENTOS"} <strong data-zip-moves>0</strong></span></div>
      <div class="zip-controls"><button type="button" class="zip-btn zip-reset" data-zip-reset>{en ? "↺ Restart" : "↺ Reiniciar"}</button><button type="button" class="zip-btn zip-undo" data-zip-undo disabled>{en ? "← Undo" : "← Deshacer"}</button><button type="button" class="zip-btn zip-hint" data-zip-hint>{en ? "✧ Hint" : "✧ Pista"}</button></div>
      <p class="zip-feedback" data-zip-feedback role="status" aria-live="polite">{en ? "Start at 1. Drag or tap adjacent cells." : "Empieza en el 1. Arrastra o toca las casillas vecinas."}</p>
      <div class="zip-rules"><span class="zip-rule-icon">↗</span><span>{en ? "Connect the numbers in order. Fill every cell without crossing the walls." : "Conecta los números en orden. Recorre todas las casillas sin cruzar los muros."}</span></div>
    </div>
    <div class="zip-board-area">
      <div class="zip-board-top"><span><span class="zip-live-dot"></span> {en ? "READY TO PLAY" : "LISTO PARA JUGAR"}</span><span data-zip-progress>1 / 25</span></div>
      <div class="zip-board" data-zip-board role="group" aria-label={en ? "Five by five puzzle board" : "Tablero de cinco por cinco"}></div>
      <div class="zip-board-bottom"><span>{en ? "Mouse, touch or keyboard" : "Mouse, táctil o teclado"}</span><span>5 × 5</span></div>
      <button class="zip-next" data-zip-next type="button" hidden>{en ? "Next level →" : "Siguiente nivel →"}</button>
    </div>
  </div>
</section>
<script>
  const games = document.querySelectorAll<HTMLElement>("[data-zip-game]");
  for (const game of games) {
    const en = game.dataset.lang === "en";
    const board = game.querySelector<HTMLElement>("[data-zip-board]")!;
    const levelText = game.querySelector<HTMLElement>("[data-zip-level]")!;
    const movesText = game.querySelector<HTMLElement>("[data-zip-moves]")!;
    const progressText = game.querySelector<HTMLElement>("[data-zip-progress]")!;
    const feedback = game.querySelector<HTMLElement>("[data-zip-feedback]")!;
    const reset = game.querySelector<HTMLButtonElement>("[data-zip-reset]")!;
    const undo = game.querySelector<HTMLButtonElement>("[data-zip-undo]")!;
    const hint = game.querySelector<HTMLButtonElement>("[data-zip-hint]")!;
    const next = game.querySelector<HTMLButtonElement>("[data-zip-next]")!;
    const size = 5;
    // Every level has a verified Hamiltonian solution; walls never cross its edges.
    const levels = [
      { route: [0,1,2,3,4,9,14,19,24,23,22,21,20,15,16,17,18,13,8,7,12,11,6,5,10], walls: [[6,7],[10,11],[18,23],[0,5]] },
      { route: [0,5,10,15,20,21,16,11,6,1,2,3,4,9,8,7,12,17,22,23,24,19,18,13,14], walls: [[15,16],[11,12],[17,18],[5,6],[12,13],[0,1],[21,22]] },
      { route: [0,1,2,3,4,9,8,7,6,5,10,11,12,13,14,19,24,23,18,17,22,21,16,15,20], walls: [[16,17],[12,17],[6,11],[22,23],[1,6],[13,18],[2,7],[11,16],[3,8],[18,19]] }
    ];
    const markers = [0, 6, 12, 18, 24];
    let level = 0;
    let path: number[] = [];
    let activePointer: number | null = null;
    let lastPoint: { x: number; y: number } | null = null;
    let solved = false;
    let cells: HTMLButtonElement[] = [];
    let routeLine: SVGPolylineElement;
    let checkpointLayer: SVGGElement;
    const svgNS = "http://www.w3.org/2000/svg";
    const point = (i: number) => ({ x: (i % size + .5) * 100, y: (Math.floor(i / size) + .5) * 100 });
    const isAdjacent = (a: number, b: number) => Math.abs(Math.floor(a / size) - Math.floor(b / size)) + Math.abs(a % size - b % size) === 1;
    const route = () => levels[level].route;
    const blocked = (a: number, b: number) => levels[level].walls.some(([x,y]) => (a === x && b === y) || (a === y && b === x));
    const message = (english: string, spanish: string) => { feedback.textContent = en ? english : spanish; };
    function render() {
      const checkpoints = new Map<number, number>(markers.map((idx, i) => [route()[idx], i + 1]));
      cells = [];
      board.replaceChildren();
      for (let i = 0; i < 25; i++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "zip-cell";
        const checkpoint = checkpoints.get(i);
        cell.setAttribute("aria-label", (en ? "Row " : "Fila ") + (Math.floor(i / size) + 1) + (en ? ", column " : ", columna ") + (i % size + 1) + (checkpoint ? ", " + (en ? "checkpoint " : "punto ") + checkpoint : ""));
        if (checkpoint) { const dot = document.createElement("span"); dot.className = "zip-number"; dot.textContent = String(checkpoint); cell.append(dot); }
        cell.addEventListener("click", (event) => { if (event.detail === 0) advance(i); });
        board.append(cell);
        cells.push(cell);
      }
      // A single SVG path crosses grid gaps seamlessly and stays aligned at any size.
      const overlay = document.createElementNS(svgNS, "svg");
      overlay.setAttribute("viewBox", "0 0 500 500");
      overlay.setAttribute("class", "zip-route-overlay");
      overlay.setAttribute("aria-hidden", "true");
      const wallsLayer = document.createElementNS(svgNS, "g");
      wallsLayer.setAttribute("class", "zip-walls-layer");
      for (const [a, b] of levels[level].walls) {
        const first = point(a);
        const second = point(b);
        const mx = (first.x + second.x) / 2;
        const my = (first.y + second.y) / 2;
        const horizontal = Math.floor(a / size) === Math.floor(b / size);
        const wall = document.createElementNS(svgNS, "line");
        wall.setAttribute("x1", String(horizontal ? mx : mx - 36));
        wall.setAttribute("y1", String(horizontal ? my - 36 : my));
        wall.setAttribute("x2", String(horizontal ? mx : mx + 36));
        wall.setAttribute("y2", String(horizontal ? my + 36 : my));
        wall.setAttribute("class", "zip-wall");
        wallsLayer.append(wall);
      }
      overlay.append(wallsLayer);
      routeLine = document.createElementNS(svgNS, "polyline");
      routeLine.setAttribute("class", "zip-route-line");
      overlay.append(routeLine);
      checkpointLayer = document.createElementNS(svgNS, "g");
      overlay.append(checkpointLayer);
      board.append(overlay);
      update();
    }
    function update() {
      const coordinates = path.map(i => point(i));
      routeLine.setAttribute("points", coordinates.map(p => p.x + "," + p.y).join(" "));
      checkpointLayer.replaceChildren();
      for (let n = 0; n < markers.length; n++) {
        const index = route()[markers[n]];
        const { x, y } = point(index);
        const circle = document.createElementNS(svgNS, "circle");
        circle.setAttribute("cx", String(x));
        circle.setAttribute("cy", String(y));
        circle.setAttribute("r", "23");
        circle.setAttribute("class", "zip-svg-marker" + (index === path[path.length - 1] ? " zip-svg-active" : ""));
        const label = document.createElementNS(svgNS, "text");
        label.setAttribute("x", String(x));
        label.setAttribute("y", String(y));
        label.setAttribute("class", "zip-svg-label");
        label.textContent = String(n + 1);
        checkpointLayer.append(circle, label);
      }
      for (let i = 0; i < cells.length; i++) {
        cells[i].classList.toggle("zip-hint-cell", false);
      }
      levelText.textContent = String(level + 1).padStart(2, "0") + " / 03";
      movesText.textContent = String(path.length - 1);
      progressText.textContent = path.length + " / 25";
      undo.disabled = path.length <= 1 || solved;
      next.hidden = !solved;
      next.textContent = level === 2 ? (en ? "Play again ↺" : "Volver a jugar ↺") : (en ? "Next level →" : "Siguiente nivel →");
    }
    function advance(i: number) {
      if (solved || i === path[path.length - 1]) return;
      if (path.length > 1 && i === path[path.length - 2]) { path.pop(); update(); return; }
      if (path.includes(i) || !isAdjacent(path[path.length - 1], i)) return;
      if (blocked(path[path.length - 1], i)) { message("A wall blocks that direction. Find another way.", "Hay un muro en esa dirección. Busca otro camino."); return; }
      const markerIndex = markers.indexOf(route().indexOf(i));
      const expected = markers.filter(index => path.includes(route()[index])).length + 1;
      if (markerIndex >= 0 && markerIndex + 1 !== expected) { message("Connect the numbers in order.", "Conecta los números en orden."); return; }
      path.push(i);
      if (path.length === 25) {
        solved = markers.every((idx, n) => path.indexOf(route()[idx]) >= 0 && (n === 0 || path.indexOf(route()[markers[n - 1]]) < path.indexOf(route()[idx])));
        if (solved) { message(level === 2 ? "All levels complete! Brilliant work." : "Puzzle solved! Ready for the next level?", level === 2 ? "¡Completaste todos los niveles! Excelente." : "¡Reto completado! ¿Listo para el siguiente nivel?"); }
        else message("Almost there! Check the number order.", "¡Casi! Revisa el orden de los números.");
      } else message("Keep going — fill every square.", "Continúa: recorre todas las casillas.");
      update();
    }
    function start() { if (activePointer !== null && board.hasPointerCapture(activePointer)) board.releasePointerCapture(activePointer); activePointer = null; lastPoint = null; path = [route()[0]]; solved = false; message("Start at 1. Drag or tap adjacent cells.", "Empieza en el 1. Arrastra o toca las casillas vecinas."); render(); }
    reset.addEventListener("click", start);
    undo.addEventListener("click", () => { if (path.length > 1 && !solved) { path.pop(); update(); } });
    hint.addEventListener("click", () => {
      if (solved) return;
      const followsSolution = path.every((cell, i) => route()[i] === cell);
      const nextCell = followsSolution ? route()[path.length] : undefined;
      if (nextCell === undefined) { message("Try undoing a move to find another route.", "Prueba deshacer un movimiento para encontrar otra ruta."); return; }
      cells[nextCell].classList.add("zip-hint-cell");
      message("The glowing square is your next step.", "La casilla iluminada es tu siguiente paso.");
    });
    next.addEventListener("click", () => { level = (level + 1) % levels.length; start(); });
    // Capture the active pointer on the board, so a held mouse button or finger
    // continues drawing even while moving across child buttons.
    function cellAt(x: number, y: number): number {
      const rect = board.getBoundingClientRect();
      if (x < rect.left || x >= rect.right || y < rect.top || y >= rect.bottom) return -1;
      const col = Math.min(size - 1, Math.floor((x - rect.left) / rect.width * size));
      const row = Math.min(size - 1, Math.floor((y - rect.top) / rect.height * size));
      return row * size + col;
    }
    function traceTo(x: number, y: number) {
      const previous = lastPoint;
      // Sample between pointer events to avoid skipping cells during fast drags.
      const distance = previous ? Math.hypot(x - previous.x, y - previous.y) : 0;
      const stepSize = Math.max(4, board.getBoundingClientRect().width / (size * 4));
      const steps = Math.max(1, Math.ceil(distance / stepSize));
      for (let n = 1; n <= steps; n++) {
        const px = previous ? previous.x + (x - previous.x) * n / steps : x;
        const py = previous ? previous.y + (y - previous.y) * n / steps : y;
        const index = cellAt(px, py);
        if (index >= 0) advance(index);
      }
      lastPoint = { x, y };
    }
    board.addEventListener("pointerdown", event => {
      if (activePointer !== null || (event.pointerType === "mouse" && event.button !== 0)) return;
      const index = cellAt(event.clientX, event.clientY);
      // Start on the first checkpoint, or resume from the current path endpoint.
      if (index !== path[0] && index !== path[path.length - 1]) return;
      activePointer = event.pointerId;
      lastPoint = { x: event.clientX, y: event.clientY };
      board.setPointerCapture(event.pointerId);
      event.preventDefault();
    });
    board.addEventListener("pointermove", event => {
      if (event.pointerId !== activePointer) return;
      if (event.pointerType === "mouse" && (event.buttons & 1) === 0) {
        activePointer = null; lastPoint = null; return;
      }
      traceTo(event.clientX, event.clientY);
      event.preventDefault();
    });
    const stopTracing = (event: PointerEvent) => {
      if (event.pointerId !== activePointer) return;
      activePointer = null;
      lastPoint = null;
      if (board.hasPointerCapture(event.pointerId)) board.releasePointerCapture(event.pointerId);
    };
    board.addEventListener("pointerup", stopTracing);
    board.addEventListener("pointercancel", stopTracing);
    board.addEventListener("lostpointercapture", event => {
      if (event.pointerId === activePointer) { activePointer = null; lastPoint = null; }
    });
    board.addEventListener("keydown", event => {
      const key = event.key;
      const current = path[path.length - 1];
      const target = key === "ArrowUp" ? current - size : key === "ArrowDown" ? current + size : key === "ArrowLeft" ? current - 1 : key === "ArrowRight" ? current + 1 : -1;
      if (target >= 0 && target < 25 && isAdjacent(current, target)) { event.preventDefault(); advance(target); cells[target].focus(); }
    });
    start();
  }
</script>
<style is:global>
  .zip-section{padding-top:95px;padding-bottom:18px}.zip-intro{margin-bottom:26px}.zip-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,410px);align-items:center;gap:clamp(24px,5vw,76px);padding:clamp(24px,4vw,54px);background:linear-gradient(130deg,#111f35,#0b1425 70%);border:1px solid #29415e;border-radius:22px;box-shadow:0 24px 65px #0003}.zip-eyebrow{color:#7fcaff;font-size:11px;font-weight:800;letter-spacing:.14em}.zip-eyebrow span{color:#79edbb}.zip-copy h3{font-size:clamp(27px,3.5vw,43px);line-height:1.1;margin:16px 0}.zip-period{color:#60bfff}.zip-copy>p{color:#b7c7df;font-size:15px;line-height:1.7;max-width:410px}.zip-info{display:flex;gap:28px;margin:32px 0 20px;flex-wrap:wrap}.zip-info>span{font-size:11px;letter-spacing:.1em;color:#90a9c7;display:flex;flex-direction:column;gap:7px}.zip-info strong{color:#eff7ff;font-size:18px;letter-spacing:0}.zip-controls{display:flex;flex-wrap:wrap;gap:9px}.zip-btn,.zip-next{font:inherit;font-size:13px;font-weight:700;cursor:pointer;padding:11px 15px;border:1px solid #3b5676;border-radius:9px;background:#172941;color:#eaf5ff;transition:background .15s,border-color .15s}.zip-btn:hover:not(:disabled),.zip-next:hover{background:#234365;border-color:#6bbfff}.zip-btn:focus-visible,.zip-next:focus-visible,.zip-cell:focus-visible{outline:2px solid #7bd4ff;outline-offset:2px}.zip-btn:disabled{opacity:.4;cursor:not-allowed}.zip-feedback{min-height:45px;margin:18px 0 14px!important;color:#8cdbb7!important;font-size:13px!important}.zip-rules{border-top:1px solid #2a3b54;padding-top:18px;display:flex;gap:12px;align-items:flex-start;color:#a9bad1;font-size:13px;line-height:1.6;max-width:390px}.zip-rule-icon{font-size:20px;color:#7ac9ff;line-height:1}.zip-board-area{background:#0b1526;border:1px solid #344b69;border-radius:16px;padding:clamp(12px,2vw,22px);min-width:0}.zip-board-top,.zip-board-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;color:#91a9c7;font-size:10px;font-weight:700;letter-spacing:.09em}.zip-board-top{margin-bottom:15px}.zip-board-bottom{margin-top:15px;letter-spacing:0;font-weight:500}.zip-live-dot{display:inline-block;width:7px;height:7px;background:#57e6a6;border-radius:50%;margin-right:6px;box-shadow:0 0 10px #57e6a6}.zip-board{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:3px;touch-action:none;user-select:none;-webkit-user-select:none;aspect-ratio:1;background:#34465f;border:3px solid #34465f;border-radius:11px;overflow:hidden}.zip-cell{position:relative;display:grid;place-items:center;border:0;border-radius:2px;background:#14243b;min-width:0;min-height:0;padding:0;cursor:pointer;touch-action:none;isolation:isolate}.zip-cell::before{content:"";position:absolute;z-index:0;background:#277fbb;opacity:0;inset:32%;border-radius:3px;transition:opacity .12s}.zip-cell.zip-filled::before{opacity:1}.zip-cell.zip-up::before{top:0}.zip-cell.zip-down::before{bottom:0}.zip-cell.zip-left::before{left:0}.zip-cell.zip-right::before{right:0}.zip-cell.zip-current::before{background:#2cbf96}.zip-cell.zip-hint-cell{background:#28533d;box-shadow:inset 0 0 0 2px #66e6ac}.zip-number{position:relative;z-index:1;display:grid;place-items:center;width:clamp(22px,65%,36px);aspect-ratio:1;background:#08111f;color:#fff;border:2px solid #5abaff;border-radius:50%;font-size:clamp(12px,2vw,17px);font-weight:800;box-shadow:0 2px 8px #0006}.zip-current .zip-number{border-color:#72efa9}.zip-next{display:block;margin-top:14px;width:100%;background:#125d9e;border-color:#248de2}.zip-next[hidden]{display:none}@media(max-width:820px){.zip-panel{grid-template-columns:1fr;gap:26px}.zip-board-area{width:100%;max-width:420px;margin:auto}.zip-info{margin:20px 0}.zip-section{padding-top:65px}}@media(max-width:480px){.zip-panel{padding:18px;border-radius:15px}.zip-board-area{padding:12px}.zip-board{gap:2px;border-width:2px}.zip-btn{padding:10px 12px;font-size:12px}.zip-section{padding-top:52px}.zip-copy h3{font-size:29px}}@media(prefers-reduced-motion:reduce){.zip-cell::before,.zip-btn,.zip-next{transition:none}}
  /* Draw one uninterrupted, rounded line rather than separate rectangles per cell. */
  .zip-board{position:relative}
  .zip-cell::before{display:none!important}
  .zip-number{visibility:hidden}
  .zip-route-overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2;overflow:visible}
  .zip-route-line{fill:none;stroke:#39a6ef;stroke-width:25;stroke-linecap:round;stroke-linejoin:round}
  .zip-wall{stroke:#f4ae62;stroke-width:9;stroke-linecap:round;filter:drop-shadow(0 0 4px #ef9b4a66)}
  .zip-walls-layer{pointer-events:none}
  .zip-svg-marker{fill:#081625;stroke:#63c7ff;stroke-width:3}
  .zip-svg-marker.zip-svg-active{stroke:#6cf1b5;fill:#12382e}
  .zip-svg-label{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:23px;font-weight:800;fill:#f5faff;text-anchor:middle;dominant-baseline:central}
</style>
