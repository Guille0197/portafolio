---
import { content, type Language } from "../data/content";
import { caseStudies } from "../data/caseStudies";
import "../styles/global.css";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = content[lang];
const cases = caseStudies[lang];
const base = import.meta.env.BASE_URL;
const current = lang === "en" ? base : base + "es/";
const other = lang === "en" ? base + "es/" : base;
const canonical = new URL(current, Astro.site).toString();
const enUrl = new URL(base, Astro.site).toString();
const esUrl = new URL(base + "es/", Astro.site).toString();
const profilePhoto = base + "gan01_97.webp";
const ogImage = new URL(base + "og-cover.svg", Astro.site).toString();
const github = "https://github.com/Guille0197";
const linkedin = "https://www.linkedin.com/in/guillermo-antonio-navarro/";
const ids = ["projects","experience","about","stack","contact"];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080e1b" />
  <meta name="author" content="Guillermo Navarro" />
  <meta name="description" content={t.seoDescription} />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={t.seoTitle} />
  <meta property="og:description" content={t.seoDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <link rel="icon" href={base + "favicon.svg"} type="image/svg+xml" />
  <title>{t.seoTitle}</title>
</head>
<body>
  <a href="#main" class="skip">{lang === "en" ? "Skip to main content" : "Saltar al contenido"}</a>
  <header class="topbar"><div class="container topbar-inner">
    <a href={current} class="identity"><span class="logo logo-code" aria-hidden="true"><span class="code-bracket">&lt;</span><span class="code-initials">GN</span><span class="code-slash"> /</span><span class="code-bracket">&gt;</span></span><span class="identity-name">Guillermo Navarro</span></a>
    <nav aria-label={lang === "en" ? "Main navigation" : "Navegación principal"} class="navlinks">{t.nav.map((name,i)=><a href={"#"+ids[i]}>{name}</a>)}</nav>
    <div class="header-actions"><a class="language" href={other} aria-label={lang === "en" ? "Cambiar a español" : "Switch to English"}>◎ {lang === "en" ? "ES" : "EN"}</a><a class="contact-top" href="#contact">{t.nav[4]} ↗</a></div>
  </div></header>
  <main id="main">
    <section class="hero container">
      <div class="hero-copy">
        
        <h1>{t.headline[0]}<br/><span class="gradient">{t.headline[1]}</span></h1>
        <p class="role-summary">{lang === "en" ? "Full Stack Developer · AWS Cloud · SaaS Builder" : "Desarrollador Full Stack · AWS Cloud · Creador SaaS"}</p><p class="intro">{t.intro}</p><p class="hero-stack" aria-label={lang === "en" ? "Core technologies" : "Tecnologías principales"}>TypeScript <span aria-hidden="true">·</span> React <span aria-hidden="true">·</span> Angular <span aria-hidden="true">·</span> Node.js <span aria-hidden="true">·</span> AWS</p><p class="location">⌁ {t.location}</p>
        <div class="actions"><a class="btn primary" href="#projects">{t.explore} ↗</a><a class="btn secondary" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="btn tertiary" href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      </div>
      <div class="hero-graphic"><div class="orbit"></div><div class="orbit orbit-small"></div><img class="portrait" src={profilePhoto} alt="Guillermo Navarro, software engineer" width="300" height="300" fetchpriority="high" /><div class="float-card available"><span class="status-dot"></span>{t.status}</div><div class="float-card code"><span class="blue">&lt;/&gt;</span> Full Stack · AWS · AI</div></div>
      <div class="stats">{t.stats.map(([value,label])=><div class="stat"><strong>{value}</strong><span>{label}</span></div>)}</div>
    </section>
    <section id="projects" class="section container">
      <div class="section-intro"><div><p class="kicker">01 / WORK</p><h2>{t.section[0]}</h2></div><p>{t.sectionDescriptions[0]}</p></div>
      <div class="projects">{t.projects.map((project,i)=><article class:list={["project",i===0 && "featured"]}>
        <div class="project-preview">{project.img ? <img src={base + project.img} alt={project.title + " preview"} loading="lazy" width="800" height="450"/> : <div class="project-placeholder"><strong>G·N</strong><code>const ideas = build();</code></div>}</div>
        <div class="project-info"><p class="micro">{project.kind}</p><h3>{project.title}<span> ↗</span></h3><p>{project.desc}</p><ul class="tags">{project.tags.map(tag=><li>{tag}</li>)}</ul><div class="project-actions"><a class="more" href={project.url} target="_blank" rel="noopener noreferrer">{project.cta} ↗</a>{"website" in project && <a class="more" href={project.website} target="_blank" rel="noopener noreferrer">{lang === "en" ? "Website" : "Sitio web"} ↗</a>}{(project.title === "Panaloyal" || project.title === "WrappedMe") && <a class="more case-link" href={"#case-"+project.title.toLowerCase()}>{lang === "en" ? "Engineering case study" : "Caso de ingeniería"} ↘</a>}</div></div>
      </article>)}</div>
      <div class="case-studies">
        <div class="case-heading"><p class="kicker">{lang === "en" ? "ENGINEERING DEEP DIVES" : "DETALLES DE INGENIERÍA"}</p><h3>{lang === "en" ? "Behind the products" : "Detrás de los productos"}</h3><p>{lang === "en" ? "Real challenges, architecture and technical decisions." : "Problemas reales, arquitectura y decisiones técnicas."}</p></div>
        {cases.map(item=><article class="case-study" id={"case-"+item.slug}><div class="case-top"><div><p class="micro">{lang === "en" ? "PRODUCT CASE STUDY" : "CASO DE PRODUCTO"}</p><h3>{item.title}</h3><p>{item.subtitle}</p></div><span class="case-number">↗</span></div>
          <div class="case-grid">
            <div><h4>{lang === "en" ? "Challenge" : "Problema"}</h4><p>{item.challenge}</p><h4>{lang === "en" ? "Solution" : "Solución"}</h4><p>{item.solution}</p></div>
            <div><h4>{lang === "en" ? "Architecture" : "Arquitectura"}</h4><ul>{item.architecture.map(x=><li>{x}</li>)}</ul></div>
            <div><h4>{lang === "en" ? "Engineering decisions" : "Decisiones técnicas"}</h4><ul>{item.decisions.map(x=><li>{x}</li>)}</ul></div>
          </div>
          <div class="case-outcome"><strong>{lang === "en" ? "Outcome" : "Resultado"}</strong><p>{item.outcome}</p><div>{item.links.map(link=><a class="more" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div>
        </article>)}
      </div>
    </section>
    <section id="experience" class="section container">
      <div class="section-intro"><div><p class="kicker">02 / CAREER</p><h2>{t.section[1]}</h2></div><p>{t.sectionDescriptions[1]}</p></div>
      <div class="career">{t.jobs.map(job=><article class="job"><div class="job-date">{job.dates}</div><div class="job-details"><h3>{job.role}</h3><p class="company">{job.company}</p><p>{job.desc}</p>{"highlights" in job && <ul class="job-highlights">{job.highlights.map(line=><li>{line}</li>)}</ul>}<ul class="tags">{job.tags.map(tag=><li>{tag}</li>)}</ul></div></article>)}</div>
    </section>
    <section id="about" class="section container about">
      <div class="about-photo"><img src={base + "gan01_97.webp"} loading="lazy" width="360" height="360" alt="Guillermo Navarro" /></div>
      <div><p class="kicker">03 / STORY</p><h2>{t.section[2]}</h2><p class="about-tagline">{t.sectionDescriptions[2]}</p>{t.about.map(paragraph=><p class="about-body">{paragraph}</p>)}<a class="more" href={github} target="_blank" rel="noopener noreferrer">{t.aboutLink} ↗</a><a class="btn resume-btn story-resume" href={base + "Guillermo_Navarro_FullStack_CV_en.pdf"} download="Guillermo_Navarro_FullStack_CV_en.pdf">{lang === "en" ? "Download Resume ↓" : "Descargar CV ↓"}</a></div>
    </section>
    <section id="stack" class="section container">
      <div class="section-intro"><div><p class="kicker">04 / TOOLKIT</p><h2>{t.section[3]}</h2></div><p>{t.sectionDescriptions[3]}</p></div>
      <div class="toolkit">{t.skills.map((group,i)=><article class:list={["skill-card",i===3 && "ai-card"]}><div class="skill-heading"><span class="skill-number">0{i+1}</span><h3>{group.title}</h3></div><div class="skills">{group.items.map(item=><span>{item}</span>)}</div></article>)}</div>
    </section>
    <section id="contact" class="container contact-section">
      <div class="contact-panel"><div><p class="kicker">05 / CONTACT</p><h2>{t.section[4]}</h2><p>{t.sectionDescriptions[4]}</p></div><div class="actions"><a class="btn primary" href="mailto:gnavarro0197@gmail.com">{t.email} ↗</a><a class="btn secondary" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    </section>
  </main>
  <footer class="container footer"><p>© {new Date().getFullYear()} Guillermo Navarro</p><p>{t.footer}</p><div><a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></footer>
</body>
</html>
